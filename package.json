{
  "name": "auto-news-video",
  "version": "2.0.0",
  "description": "Auto-generate Vietnamese 9:16 short news videos from URL/txt — Claude Code skill + HyperFrames + LucyLab/ElevenLabs TTS",
  "main": "src/cli.ts",
  "bin": {
    "auto-video": "./bin/auto-video.js"
  },
  "directories": {
    "doc": "docs"
  },
  "type": "module",
  "scripts": {
    "setup": "tsx scripts/setup-doctor.ts",
    "studio": "npm run build && node dist/cli.js series:studio",
    "test": "node scripts/run-tests.mjs",
    "test:watch": "vitest",
    "pipeline": "tsx src/cli.ts",
    "series": "tsx src/cli.ts",
    "rerender": "tsx rerender.ts",
    "typecheck": "tsc --noEmit && tsc -p studio/tsconfig.json && tsc -p tsconfig.tooling.json",
    "build": "node scripts/build.mjs",
    "sfx:download": "tsx scripts/download-sfx.ts",
    "sfx:filter": "tsx scripts/filter-sfx.ts",
    "build:studio": "vite build --config studio/vite.config.ts",
    "test:unit": "node scripts/run-tests.mjs --project unit",
    "test:integration": "node scripts/run-tests.mjs --project integration",
    "test:frontend": "node scripts/run-tests.mjs --project frontend",
    "test:media": "node scripts/run-tests.mjs --project media",
    "smoke:runtime": "node scripts/runtime-smoke.mjs",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "benchmark": "tsx scripts/benchmark-optimization.ts",
    "smoke:container": "node scripts/container-smoke.mjs",
    "check:architecture": "node scripts/check-architecture.mjs"
  },
  "keywords": [
    "video",
    "tts",
    "news",
    "vietnamese",
    "tiktok",
    "shorts",
    "hyperframes",
    "claude-code",
    "lucylab",
    "elevenlabs"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.15.2",
    "dotenv": "^17.4.2",
    "hyperframes": "^0.4.34",
    "p-limit": "^7.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.5",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "nock": "^14.0.13",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.5"
  }
}
